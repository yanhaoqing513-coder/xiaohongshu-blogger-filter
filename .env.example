# Ollama配置
# 如果使用云端模型，请先在本机完成 Ollama 登录；也可以改成自己可用的本地视觉模型。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:235b-cloud

# 浏览器配置。CHROME_PATH 留空时会自动尝试查找 Google Chrome/Chromium。
BROWSER_HEADLESS=false
CHROME_PATH=
PAGE_LOAD_TIMEOUT=30000

# Web服务端口
PORT=5001

# 访问频率控制
COLLECT_MIN_DELAY=1
COLLECT_MAX_DELAY=3
COLLECT_BATCH_SIZE=20
COLLECT_BATCH_REST_MIN=10
COLLECT_BATCH_REST_MAX=20
